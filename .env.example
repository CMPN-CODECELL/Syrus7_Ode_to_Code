# ==============================================================================
# KrishiNirnay — Environment Configuration Example (.env.example)
# Project: "Sahi Bhav Se, Samriddhi Ki Raah Pe."
# Syrus 7.0 / Agriculture PS2: AI Market and Risk Intelligence for Agri Supply Chains
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env and provide your actual API keys.
# KrishiNirnay functions 100% offline using verified snapshots and deterministic
# templates if external API keys are omitted.
# ==============================================================================

# Application Environment & Server Settings
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Division 3: AI & Voice Providers
# ------------------------------------------------------------------------------
# Primary LLM: Google Gemini 3.8 Flash (Orchestration, slot extraction, narration)
# Primary TTS: Gemini 3.8 Flash-Lite Text-to-Speech (Concise Marathi/Hindi audio)
GEMINI_API_KEY=

# Fallback LLM: Groq openai/gpt-oss-20b
# Primary ASR: Groq Whisper Large V3 Turbo (Multilingual transcription)
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# Division 2: Routing & External Economics
# ------------------------------------------------------------------------------
# Routing Provider: OpenRouteService via current api.heigit.org endpoints
# If omitted or unavailable, routing safely falls back to cached routes and
# visibly labelled Haversine road-distance estimates.
ORS_API_KEY=

# Weather Providers: Open-Meteo & IMD Alerts (Optional, free tier default)
OPEN_METEO_API_KEY=
IMD_API_KEY=

# ------------------------------------------------------------------------------
# Division 1: Market Data Sources
# ------------------------------------------------------------------------------
# Official OGD / data.gov.in API key for daily AGMARKNET mandi price feeds.
# If omitted, system runs from clean analytical series & verified demo snapshots.
DATAGOV_API_KEY=

# CEDA (Centre for Economic Data and Analysis) API key or access token (Optional)
CEDA_API_KEY=

# ------------------------------------------------------------------------------
# Microservice vs Monolith Interconnect
# ------------------------------------------------------------------------------
# Set to 'true' if running independent microservice containers on separate ports.
# Default 'false' uses integrated direct in-process execution.
USE_LIVE_INTERNAL_SERVICES=false
DIV1_BASE_URL=http://localhost:8001
DIV2_BASE_URL=http://localhost:8002
