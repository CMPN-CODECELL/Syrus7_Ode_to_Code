{
  "$defs": {
    "AssumptionRecord": {
      "description": "Explicit inspection metadata for an economic or physical parameter.",
      "properties": {
        "param": {
          "title": "Param",
          "type": "string"
        },
        "value": {
          "title": "Value"
        },
        "status": {
          "enum": [
            "VERIFIED",
            "ASSUMPTION"
          ],
          "title": "Status",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "last_verified": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Verified"
        }
      },
      "required": [
        "param",
        "value",
        "status"
      ],
      "title": "AssumptionRecord",
      "type": "object"
    },
    "BaselineRecord": {
      "description": "The baseline action: sell at home mandi today.",
      "properties": {
        "market": {
          "title": "Market",
          "type": "string"
        },
        "sale_day": {
          "title": "Sale Day",
          "type": "string"
        },
        "net_total": {
          "title": "Net Total",
          "type": "number"
        },
        "gross_revenue": {
          "title": "Gross Revenue",
          "type": "number"
        },
        "quantity_sold_qtl": {
          "title": "Quantity Sold Qtl",
          "type": "number"
        },
        "price_inr_per_qtl": {
          "title": "Price Inr Per Qtl",
          "type": "number"
        },
        "modal_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modal Price"
        },
        "costs": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Costs",
          "type": "object"
        },
        "cost_breakdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostBreakdown"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "market",
        "sale_day",
        "net_total",
        "gross_revenue",
        "quantity_sold_qtl",
        "price_inr_per_qtl",
        "costs"
      ],
      "title": "BaselineRecord",
      "type": "object"
    },
    "CandidateEvaluation": {
      "description": "Evaluated option across mandi x day horizon for the 3x7 heatmap.",
      "properties": {
        "market": {
          "title": "Market",
          "type": "string"
        },
        "sale_day": {
          "title": "Sale Day",
          "type": "string"
        },
        "holding_days": {
          "title": "Holding Days",
          "type": "integer"
        },
        "price_inr_per_qtl": {
          "title": "Price Inr Per Qtl",
          "type": "number"
        },
        "quantile_used": {
          "title": "Quantile Used",
          "type": "string"
        },
        "net_total": {
          "title": "Net Total",
          "type": "number"
        },
        "gain_pct": {
          "title": "Gain Pct",
          "type": "number"
        },
        "probability_beat_baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability Beat Baseline"
        },
        "reservation_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reservation Price"
        },
        "is_open": {
          "title": "Is Open",
          "type": "boolean"
        },
        "is_feasible": {
          "title": "Is Feasible",
          "type": "boolean"
        },
        "is_safe": {
          "title": "Is Safe",
          "type": "boolean"
        },
        "disqualification_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disqualification Reason"
        },
        "costs": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Costs",
          "type": "object"
        },
        "breakdown": {
          "title": "Breakdown",
          "type": "object"
        }
      },
      "required": [
        "market",
        "sale_day",
        "holding_days",
        "price_inr_per_qtl",
        "quantile_used",
        "net_total",
        "gain_pct",
        "is_open",
        "is_feasible",
        "is_safe",
        "costs",
        "breakdown"
      ],
      "title": "CandidateEvaluation",
      "type": "object"
    },
    "ChosenRecord": {
      "description": "The winning recommendation that passed all safety and economic gates.",
      "properties": {
        "action": {
          "enum": [
            "SELL_NOW",
            "WAIT",
            "GO",
            "INSUFFICIENT_EVIDENCE"
          ],
          "title": "Action",
          "type": "string"
        },
        "market": {
          "title": "Market",
          "type": "string"
        },
        "sale_day": {
          "title": "Sale Day",
          "type": "string"
        },
        "net_total": {
          "title": "Net Total",
          "type": "number"
        },
        "gain_total": {
          "title": "Gain Total",
          "type": "number"
        },
        "gain_pct": {
          "title": "Gain Pct",
          "type": "number"
        },
        "probability_beat_baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability Beat Baseline"
        },
        "reservation_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reservation Price"
        },
        "required_gain_pct": {
          "title": "Required Gain Pct",
          "type": "number"
        },
        "quantity_sold_qtl": {
          "title": "Quantity Sold Qtl",
          "type": "number"
        },
        "holding_days": {
          "title": "Holding Days",
          "type": "integer"
        },
        "wait_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wait Days"
        },
        "modal_price_expected": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modal Price Expected"
        },
        "costs": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Costs",
          "type": "object"
        },
        "cost_breakdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostBreakdown"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action",
        "market",
        "sale_day",
        "net_total",
        "gain_total",
        "gain_pct",
        "required_gain_pct",
        "quantity_sold_qtl",
        "holding_days",
        "costs"
      ],
      "title": "ChosenRecord",
      "type": "object"
    },
    "CostBreakdown": {
      "description": "Detailed logistics and perishability cost breakdown.",
      "properties": {
        "gross_revenue": {
          "description": "Gross revenue before deductions (INR)",
          "title": "Gross Revenue",
          "type": "number"
        },
        "transport": {
          "description": "Transport cost including round trip & trips (INR)",
          "title": "Transport",
          "type": "number"
        },
        "hamali_tolai": {
          "description": "Hamali/weighment labor fees (INR)",
          "title": "Hamali Tolai",
          "type": "number"
        },
        "commission_fees": {
          "default": 0.0,
          "description": "Market commission and APMC cess (INR)",
          "title": "Commission Fees",
          "type": "number"
        },
        "storage": {
          "default": 0.0,
          "description": "Holding storage cost (INR)",
          "title": "Storage",
          "type": "number"
        },
        "financing": {
          "default": 0.0,
          "description": "Financing cost of tied capital (INR)",
          "title": "Financing",
          "type": "number"
        },
        "travel_loss_pct": {
          "default": 0.0,
          "description": "Perishability transit loss percentage (e.g. 0.01 for 1%)",
          "title": "Travel Loss Pct",
          "type": "number"
        },
        "holding_loss_pct": {
          "default": 0.0,
          "description": "Perishability holding loss percentage (e.g. 0.02 for 2%)",
          "title": "Holding Loss Pct",
          "type": "number"
        },
        "quality_factor": {
          "default": 1.0,
          "description": "Quality multiplier (1.0 = standard grade)",
          "title": "Quality Factor",
          "type": "number"
        },
        "quantity_initial_qtl": {
          "description": "Initial lot quantity in quintals",
          "title": "Quantity Initial Qtl",
          "type": "number"
        },
        "quantity_sold_qtl": {
          "description": "Net saleable quantity in quintals after sequential losses",
          "title": "Quantity Sold Qtl",
          "type": "number"
        },
        "final_net": {
          "description": "Final net realization (INR)",
          "title": "Final Net",
          "type": "number"
        }
      },
      "required": [
        "gross_revenue",
        "transport",
        "hamali_tolai",
        "quantity_initial_qtl",
        "quantity_sold_qtl",
        "final_net"
      ],
      "title": "CostBreakdown",
      "type": "object"
    },
    "ExplanationPayload": {
      "description": "Immutable deterministic explanation evidence.",
      "properties": {
        "verdict": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Concise headline verdict",
          "title": "Verdict"
        },
        "why": {
          "description": "High-level bulleted rationale for the farmer",
          "items": {
            "type": "string"
          },
          "title": "Why",
          "type": "array"
        },
        "key_drivers": {
          "description": "Top quantitative drivers that determined the outcome",
          "items": {
            "type": "string"
          },
          "title": "Key Drivers",
          "type": "array"
        },
        "evidence": {
          "description": "Strict machine-readable evidence dictionary",
          "title": "Evidence",
          "type": "object"
        },
        "spoken_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short 3-part spoken text: verdict, net amount, main risk",
          "title": "Spoken Summary"
        }
      },
      "required": [
        "why",
        "key_drivers",
        "evidence"
      ],
      "title": "ExplanationPayload",
      "type": "object"
    },
    "RiskAssessment": {
      "description": "Complete six-risk assessment output with overrides and explanations.",
      "properties": {
        "overall": {
          "description": "Overall risk status: 'GREEN', 'YELLOW', or 'RED'",
          "title": "Overall",
          "type": "string"
        },
        "score": {
          "description": "Weighted composite risk score R in [0.0, 1.0]",
          "title": "Score",
          "type": "number"
        },
        "raw_score": {
          "description": "Score before safety overrides",
          "title": "Raw Score",
          "type": "number"
        },
        "flags": {
          "description": "The six individual risk flags",
          "items": {
            "$ref": "#/$defs/RiskFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "overrides_applied": {
          "description": "List of safety overrides triggered",
          "items": {
            "type": "string"
          },
          "title": "Overrides Applied",
          "type": "array"
        },
        "is_wait_blocked_by_risk": {
          "default": false,
          "description": "True if risk policies strictly block Wait",
          "title": "Is Wait Blocked By Risk",
          "type": "boolean"
        },
        "is_go_blocked_by_risk": {
          "default": false,
          "description": "True if risk policies strictly block Go",
          "title": "Is Go Blocked By Risk",
          "type": "boolean"
        },
        "blocking_reasons": {
          "description": "Detailed blocking explanations",
          "items": {
            "type": "string"
          },
          "title": "Blocking Reasons",
          "type": "array"
        }
      },
      "required": [
        "overall",
        "score",
        "raw_score",
        "flags"
      ],
      "title": "RiskAssessment",
      "type": "object"
    },
    "RiskFlag": {
      "description": "Individual evaluated risk flag.",
      "properties": {
        "name": {
          "description": "Flag name: price_drop, arrival_spike, volatility, stale_data, forecast_reliability, weather",
          "title": "Name",
          "type": "string"
        },
        "status": {
          "description": "'GREEN', 'YELLOW', or 'RED'",
          "title": "Status",
          "type": "string"
        },
        "score": {
          "description": "0.0 for Green, 0.5 for Yellow, 1.0 for Red",
          "title": "Score",
          "type": "number"
        },
        "weight": {
          "description": "Configured weight in overall score",
          "title": "Weight",
          "type": "number"
        },
        "reason": {
          "description": "Deterministic reason for flag classification",
          "title": "Reason",
          "type": "string"
        },
        "metrics": {
          "description": "Underlying quantitative metrics",
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "name",
        "status",
        "score",
        "weight",
        "reason"
      ],
      "title": "RiskFlag",
      "type": "object"
    },
    "SourceRefRecord": {
      "description": "Audit reference to upstream data sources.",
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "fetched_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fetched At"
        }
      },
      "required": [
        "type",
        "source",
        "ref"
      ],
      "title": "SourceRefRecord",
      "type": "object"
    }
  },
  "description": "Immutable DecisionRecord: Single Source of Truth for KrishiNirnay.",
  "properties": {
    "request_id": {
      "description": "Unique request UUID",
      "title": "Request Id",
      "type": "string"
    },
    "engine_version": {
      "default": "1.0.0",
      "description": "Decision engine software version",
      "title": "Engine Version",
      "type": "string"
    },
    "data_snapshot_id": {
      "description": "ID/Hash of market data snapshot",
      "title": "Data Snapshot Id",
      "type": "string"
    },
    "rules_version": {
      "default": "1.0.0",
      "description": "Version of risk and gate rules",
      "title": "Rules Version",
      "type": "string"
    },
    "forecast_model_version": {
      "default": "1.0.0",
      "description": "Version of predictive model",
      "title": "Forecast Model Version",
      "type": "string"
    },
    "calibration_version": {
      "default": "1.0.0",
      "description": "Version of conformal calibration",
      "title": "Calibration Version",
      "type": "string"
    },
    "cost_config_version": {
      "default": "1.0.0",
      "description": "Version of cost configuration file",
      "title": "Cost Config Version",
      "type": "string"
    },
    "weather_snapshot_id": {
      "default": "weather-snap-v1",
      "description": "ID of weather context snapshot",
      "title": "Weather Snapshot Id",
      "type": "string"
    },
    "route_snapshot_id": {
      "default": "route-snap-v1",
      "description": "ID of routing context snapshot",
      "title": "Route Snapshot Id",
      "type": "string"
    },
    "timestamp": {
      "description": "ISO-8601 generation timestamp",
      "title": "Timestamp",
      "type": "string"
    },
    "commodity": {
      "default": "Tomato",
      "description": "Commodity name",
      "title": "Commodity",
      "type": "string"
    },
    "lot_quantity_qtl": {
      "default": 20.0,
      "description": "Lot quantity in quintals",
      "title": "Lot Quantity Qtl",
      "type": "number"
    },
    "risk_profile": {
      "default": "BALANCED",
      "description": "Risk profile",
      "title": "Risk Profile",
      "type": "string"
    },
    "baseline": {
      "$ref": "#/$defs/BaselineRecord",
      "description": "Home mandi sell-today baseline"
    },
    "chosen": {
      "$ref": "#/$defs/ChosenRecord",
      "description": "Selected policy recommendation"
    },
    "forecast": {
      "description": "Forecast summary",
      "title": "Forecast",
      "type": "object"
    },
    "risk": {
      "$ref": "#/$defs/RiskAssessment",
      "description": "Six-risk assessment"
    },
    "warnings": {
      "description": "Operational and quality warnings",
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "assumptions": {
      "description": "Inspectable parameter assumptions",
      "items": {
        "$ref": "#/$defs/AssumptionRecord"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "source_refs": {
      "description": "Data provenance references",
      "items": {
        "$ref": "#/$defs/SourceRefRecord"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "explanation": {
      "$ref": "#/$defs/ExplanationPayload",
      "description": "Deterministic explanation and Why cards"
    },
    "candidates": {
      "description": "All evaluated candidate cells (3x7 grid)",
      "items": {
        "$ref": "#/$defs/CandidateEvaluation"
      },
      "title": "Candidates",
      "type": "array"
    },
    "hysteresis_applied": {
      "default": false,
      "description": "True if recommendation flip was suppressed by hysteresis",
      "title": "Hysteresis Applied",
      "type": "boolean"
    }
  },
  "required": [
    "request_id",
    "data_snapshot_id",
    "timestamp",
    "baseline",
    "chosen",
    "risk",
    "explanation"
  ],
  "title": "DecisionRecord",
  "type": "object"
}